# --- control plane ---
DATABASE_URL=postgresql+psycopg://avatar:avatar@localhost:5432/avatar_studio
S3_ENDPOINT=http://localhost:9000          # MinIO in dev, R2/S3 in prod
S3_PUBLIC_ENDPOINT=                         # set only in docker-compose (browser needs localhost, not the container hostname); blank = same as S3_ENDPOINT
S3_BUCKET=avatar-studio
S3_REGION=auto                              # R2 uses "auto"; real AWS S3 would use e.g. "us-east-1"
S3_ACCESS_KEY=minioadmin                    # matches docker-compose's MinIO MINIO_ROOT_USER for local dev
S3_SECRET_KEY=minioadmin                    # matches docker-compose's MinIO MINIO_ROOT_PASSWORD for local dev
JWT_SECRET=dev-secret-change-me             # single-user auth; replace before any non-local deploy
FOUNDER_EMAIL=syedautomates@gmail.com       # seeded single user
WORKER_TOKEN=dev-worker-token-change-me     # shared secret for /internal/* routes
WEB_ORIGIN=http://localhost:3000            # M6 Next.js wizard's origin, for CORS

# --- external APIs ---
ELEVENLABS_API_KEY=...
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_FALLBACK_MODEL=eleven_multilingual_v2   # for >10k-char chunks if v3 rejects
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB   # "Adam" - stock American voice; used before user clones
ANTHROPIC_API_KEY=...
ORCHESTRATOR_MODEL=claude-sonnet-5          # re-verify against console.anthropic.com before hardcoding
RUNPOD_API_KEY=...                          # not in claude.md's original list — needed to provision/inspect
                                             # GPU pods programmatically (M3+); console.runpod.io > Settings > API Keys

# --- worker (set on the GPU pod, not local dev) ---
API_BASE_URL=https://api.yourdomain.com
WORKER_POLL_INTERVAL_S=5                    # long-poll sleep between empty /internal/jobs/next checks
HF_TOKEN=...                                # HuggingFace weight downloads
VIDEO_MODEL=liveavatar                      # liveavatar (primary) | longcat (fallback, per M5 bake-off)
LIVEAVATAR_ENABLE_COMPILE=true
LIVEAVATAR_ENABLE_FP8=false
LONGCAT_FLAGS=--use_distill --use_int8
AUDIO_CFG=4
SEEDVR2_VARIANT=3b_fp16
TARGET_RESOLUTION=4k

# --- apps/web (M6 Next.js wizard) — its own .env.local, not this file; documented here
# because apps/web/.gitignore excludes .env* entirely, including a tracked example.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
